# Vercel Deploy Hook URL
# Get this from: Vercel Dashboard -> Your Project -> Settings -> Git -> Deploy Hooks
# Create a new deploy hook and paste the URL here
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# Supabase Auth (Berkeley Google sign-in)
# Get these from: Supabase Dashboard -> Your Project -> Settings -> API
# See docs/auth-berkeley.md for the full setup. The anon key is public
# by design; never put the service_role key in the app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sign-in gate flag. Only the exact string 'true' turns the gate on;
# anything else (including unset) leaves the site public as today.
# The merge ships with this OFF; flip it ON in Vercel (and redeploy)
# after the Google consent screen is published. See docs/auth-berkeley.md.
AUTH_GATE_ENABLED=false

# Supabase "Before User Created" hook secret. Supabase issues this as
# "v1,whsec_..." when the hook is enabled (Dashboard -> Authentication
# -> Hooks). The hook endpoint (/api/auth/before-user-created) verifies
# the Standard Webhooks HMAC signature with it. If unset, the endpoint
# skips signature verification but still enforces the berkeley.edu
# domain check. Set it in Vercel after enabling the hook.
SUPABASE_AUTH_HOOK_SECRET=

# Other environment variables...
