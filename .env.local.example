# Vercel Deploy Hook URL
# Get this from: Vercel Dashboard -> Your Project -> Settings -> Git -> Deploy Hooks
# Create a new deploy hook and paste the URL here
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# Supabase Auth (Berkeley Google sign-in)
# Get these from: Supabase Dashboard -> Your Project -> Settings -> API
# See docs/auth-berkeley.md for the full setup. The anon key is public
# by design; never put the service_role key in the app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Other environment variables...
